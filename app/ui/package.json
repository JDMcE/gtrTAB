{
  "name": "gtrtab-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/gtr-wasm --target web --out-dir ../../app/ui/src/wasm",
    "worklet": "node scripts/build-worklet.mjs",
    "soundfont": "node scripts/fetch-soundfont.mjs",
    "dev": "npm run wasm -- --dev && npm run worklet && vite",
    "build": "npm run wasm && npm run worklet && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test \"src/**/*.test.mjs\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wasm-pack": "^0.15.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0"
  }
}
